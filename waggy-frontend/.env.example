# Public frontend config only. Safe to expose to the browser.
# Never put API secrets, Gemini keys, database credentials, or tokens here.

# Base URL of the Waggy HTTP API (no trailing slash).
# Used when this frontend is hosted separately from the API.
WAGGY_API_BASE_URL=http://localhost:8000

# Vite-compatible alias of the same public value (optional).
VITE_WAGGY_API_BASE_URL=http://localhost:8000
